{
  "name": "Lab shop (scripts/e2e.sh)",
  "expectations": [
    {"name": "Ordinary user is served the administration page", "present": true, "rule_contains": "unauthorized-access", "target_contains": "/admin/users"},
    {"name": "Orders API answers without authentication", "present": true, "rule_contains": "auth-not-enforced", "target_contains": "/api/orders"},
    {"name": "Access key in settings.py", "present": true, "rule_contains": "aws-access-key-id", "target_contains": "settings.py"},
    {"name": "Account page refuses anonymous visitors", "present": false, "rule_contains": "unauthenticated-access", "target_contains": "/account"},
    {"name": "Health endpoint is public by design", "present": false, "rule_contains": "auth-not-enforced", "target_contains": "/api/health"}
  ]
}
